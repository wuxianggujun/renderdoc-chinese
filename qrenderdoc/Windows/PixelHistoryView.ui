      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;***&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:18px; color:#1f2328; background-color:#ffffff;&quot;&gt;代码覆盖预览&lt;/span&gt;*** &lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:18px; color:#1f2328; background-color:#ffffff;&quot;&gt;在可见范围内显示的预览颜色 &lt;/span&gt; {min} - {max} &lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:18px; color:#1f2328; background-color:#ffffff;&quot;&gt;包含&lt;/span&gt; {&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:18px; color:#1f2328; background-color:#ffffff;&quot;&gt;红色, 蓝色, 绿色&lt;/span&gt;} &lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:18px; color:#1f2328; background-color:#ffffff;&quot;&gt;通道&lt;/span&gt;.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:18px; color:#1f2328; background-color:#ffffff;&quot;&gt;右键单击以调试事件、隐藏失败事件或跳转到网格视图中的修改原语。&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
